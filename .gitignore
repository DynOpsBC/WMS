licensing-service/node_modules/
licensing-service/dist/
# licensing-service/pnpm-lock.yaml is committed on purpose: test-full.yml installs it
# with --frozen-lockfile and caches on that exact path, so ignoring it kept the
# "Licensing service" CI job permanently red. The portal/push-relay lockfiles below are
# still ignored and their jobs still fail the same way — same fix when someone owns them.
customer-portal/node_modules/
customer-portal/dist/
customer-portal/pnpm-lock.yaml
customer-portal/api/node_modules/
customer-portal/api/dist/
customer-portal/api/pnpm-lock.yaml
push-relay/pnpm-lock.yaml
local.settings.json
licensing-service/package-lock.json
.claude/settings.local.json
.playwright-mcp/

# Release APK'lari depoda tutulmaz: her biri ~30 MB, git gecmisini sisiriyordu
# (27 APK = 805 MB, .git 512 MB'a cikmisti). Yayinlanan surumler GitHub
# Releases'e yuklenir. Bilerek eklemek gerekirse: git add -f <dosya>
releases/**/*.apk
