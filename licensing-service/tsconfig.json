{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "license-issue/**/*.ts",
    "license-verify/**/*.ts",
    "license-me/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts"
  ]
}
