+            if (destinations.isEmpty()) Text("Bu LP'nin ürünleri seçilen emirde bulunamadı.", color = MaterialTheme.colorScheme.error)
+            else destinations.forEach { Text(it, fontSize = 13.sp) }
+            Text(
