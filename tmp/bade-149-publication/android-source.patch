+        val loaded = mutableListOf<Int>()
+        val plans = planDocumentPalletRows(rows, listOf(selectedB to 5.0, selectedA to 4.0)) { no ->
+            loaded += no
+            sourceResult(rows.first { it.getInt("lineNo") == no })
