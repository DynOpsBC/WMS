<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>DKC-Production-Print-Agent-Setup</AssemblyName>
    <RootNamespace>DynOps.DKCProduction.PrintAgent.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(PayloadZip)' != ''">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="DKC.PrintAgent.Payload.zip" />
  </ItemGroup>

  <Target Name="RequirePayload" BeforeTargets="BeforeBuild">
    <Error Condition="'$(PayloadZip)' == ''" Text="PayloadZip must point to the validated DKC agent payload zip." />
    <Error Condition="!Exists('$(PayloadZip)')" Text="PayloadZip does not exist: $(PayloadZip)" />
  </Target>
</Project>
