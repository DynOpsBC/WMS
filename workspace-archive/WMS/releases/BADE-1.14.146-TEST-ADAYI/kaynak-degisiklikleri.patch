+
+    @Test
+    fun `full document registration still rejects an unrelated staged row without pallets`() {
+        val unrelated = row(10000, staged = 1.0).put("itemNo", "YM.00273").put("binCode", "Y.A01.11")
+        val selected = row(20000, staged = 5.0)
